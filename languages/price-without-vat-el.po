msgid "incl. VAT"
msgstr "με ΦΠΑ"

msgid "excl. VAT"
msgstr "χωρίς ΦΠΑ"

msgid "Price With/Without VAT"
msgstr "Τιμή με/χωρίς ΦΠΑ"

msgid "Settings saved."
msgstr "Οι ρυθμίσεις αποθηκεύτηκαν."

msgid "Audience"
msgstr "Κοινό"

msgid "Everyone"
msgstr "Όλοι"

msgid "Logged-in users only"
msgstr "Μόνο συνδεδεμένοι χρήστες"

msgid "Selected user roles"
msgstr "Επιλεγμένοι ρόλοι χρηστών"

msgid "Show prices to"
msgstr "Εμφάνιση τιμών σε"

msgid "Choose who sees the with/without VAT prices."
msgstr "Επιλέξτε ποιος βλέπει τις τιμές με/χωρίς ΦΠΑ."

msgid "User roles"
msgstr "Ρόλοι χρηστών"

msgid "Only used when \"Selected user roles\" is chosen above."
msgstr "Χρησιμοποιείται μόνο όταν έχει επιλεγεί «Επιλεγμένοι ρόλοι χρηστών» παραπάνω."

msgid "Display locations"
msgstr "Σημεία εμφάνισης"

msgid "Single product page"
msgstr "Σελίδα προϊόντος"

msgid "Shop / category archives"
msgstr "Κατάστημα / αρχεία κατηγοριών"

msgid "Cart"
msgstr "Καλάθι"

msgid "Checkout"
msgstr "Ταμείο"

msgid "Show here"
msgstr "Εμφάνιση εδώ"

msgid "Price lines"
msgstr "Γραμμές τιμής"

msgid "Price including VAT"
msgstr "Τιμή με ΦΠΑ"

msgid "Show the price including VAT"
msgstr "Εμφάνιση της τιμής με ΦΠΑ"

msgid "Label shown next to the price including VAT."
msgstr "Ετικέτα που εμφανίζεται δίπλα στην τιμή με ΦΠΑ."

msgid "Price excluding VAT"
msgstr "Τιμή χωρίς ΦΠΑ"

msgid "Show the price excluding VAT"
msgstr "Εμφάνιση της τιμής χωρίς ΦΠΑ"

msgid "Label shown next to the price excluding VAT."
msgstr "Ετικέτα που εμφανίζεται δίπλα στην τιμή χωρίς ΦΠΑ."

msgid "Save settings"
msgstr "Αποθήκευση ρυθμίσεων"

msgid "Price With/Without VAT by"
msgstr "Τιμή με/χωρίς ΦΠΑ από"

#. translators: 1: required WooCommerce version, 2: active WooCommerce version.
msgid "Price With/Without VAT requires WooCommerce %1$s or newer. You are running %2$s. The plugin is inactive until WooCommerce is updated."
msgstr "Το Price With/Without VAT απαιτεί WooCommerce %1$s ή νεότερη έκδοση. Εκτελείτε %2$s. Το πρόσθετο είναι ανενεργό μέχρι να ενημερωθεί το WooCommerce."
